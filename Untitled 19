        "# ## Section 24: Rolling-window panel (many labelled examples)\n",
        "# One snapshot every 7 days. Features come from the previous 28 days, the target from the next 14 days."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "QagSC4LaW07i",
        "outputId": "8ec61705-ac22-42fb-decb-2e463b48aa92"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Snapshots: 26 | rows: 1040 | labelled rows: 735 (71%) | features: 14\n",
            "Future shortfall quantiles over labelled rows (10, 33, 50, 67, 90%): [-0.2407 -0.0544  0.007   0.077   0.2658]\n"
          ]
        }
      ],
      "source": [
        "\n",
        "LOOKBACK, HORIZON, STRIDE = 28, 14, 7\n",
        "MIN_FUTURE_SALES_H = 50.0                          # units ordered in the horizon below which a shortfall rate is not defined\n",
        "GAP = int(np.ceil(HORIZON / STRIDE))               # snapshots dropped between train and test so target windows never overlap\n",
        "\n",
        "dates_all = sorted(md[\"Date\"].unique()); T = len(dates_all)\n",
        "prods = list(product_features[\"Product\"]); NP = len(prods)\n",
        "piv = {c: md.pivot(index=\"Date\", columns=\"Product\", values=c).reindex(index=dates_all, columns=prods).fillna(0.0).values\n",
        "       for c in [\"Sales\", \"Production\", \"FactoryIssue\", \"Delivery\"]}          # each array is (days, products)\n",
        "starts = list(range(LOOKBACK, T - HORIZON + 1, STRIDE)); n_snap = len(starts)\n",
        "\n",
        "PF = [\"TotalSales\", \"TotalProduction\", \"TotalFactoryIssue\", \"TotalDelivery\", \"SalesCV\", \"ProductionCV\",\n",
        "      \"ProductionEfficiency\", \"DeliveryEfficiency\", \"FactoryIssueRatio\", \"SalesGap\", \"ProductionGap\",\n",
        "      \"Shortfall7d\", \"ShortfallLookback\"]\n",
        "def snap_features(t):\n",
        "    sl = slice(t - LOOKBACK, t)\n",
        "    S, P, Fi, D = (piv[c][sl] for c in (\"Sales\", \"Production\", \"FactoryIssue\", \"Delivery\"))\n",
        "    S_t, P_t, F_t, D_t = S.sum(0), P.sum(0), Fi.sum(0), D.sum(0)\n",
        "    cv = lambda A: A.std(0) / (A.mean(0) + eps)\n",
        "    s7, d7 = S[-7:].sum(0), D[-7:].sum(0)\n",
        "    return np.column_stack([S_t, P_t, F_t, D_t, cv(S), cv(P), P_t / (S_t + eps), D_t / (S_t + eps), F_t / (P_t + eps),\n",
        "                            S_t - D_t, P_t - S_t, (s7 - d7) / (s7 + eps), (S_t - D_t) / (S_t + eps)])\n",
        "\n",
        "Xraw = np.stack([snap_features(t) for t in starts])                       # (snapshots, products, 13)\n",
        "futS = np.stack([piv[\"Sales\"][t:t + HORIZON].sum(0) for t in starts])\n",
        "futD = np.stack([piv[\"Delivery\"][t:t + HORIZON].sum(0) for t in starts])\n",
        "short = (futS - futD) / (futS + eps)\n",
        "\n",
        "Xt = Xraw.copy()\n",
        "for c in [0, 1, 2, 3, 9, 10]:                                              # heavy-tailed counts and gaps: signed log\n",
        "    Xt[..., c] = np.sign(Xt[..., c]) * np.log1p(np.abs(Xt[..., c]))\n",
        "Xt[..., [6, 7, 8]] = np.clip(Xt[..., [6, 7, 8]], -10, 10)\n",
        "Xt[..., [4, 5]] = np.clip(Xt[..., [4, 5]], 0, 10)\n",
        "Xt[..., [11, 12]] = np.clip(Xt[..., [11, 12]], -5, 1)\n",
        "\n",
        "deg = np.array([dict(G.degree())[p] for p in prods], dtype=float)\n",
