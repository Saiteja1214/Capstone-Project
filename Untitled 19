        "\n",
        "\n",
        "import torch\n",
        "LAGN = [\"TotalSales\", \"DeliveryEfficiency\", \"Shortfall7d\", \"ShortfallLookback\", \"BacklogWeeks\"]\n",
        "LAGC = [FEATS2.index(n) for n in LAGN]\n",
        "Xl = np.zeros((n_snap, NP, len(LAGC)))\n",
        "Xl[1:] = Xt2[:-1][..., LAGC]                                   # previous snapshot (zeros for the first one)\n",
        "Xt3 = np.concatenate([Xt2, Xl, Xt2[..., LAGC] - Xl], axis=2)   # current, lag, and change since the last snapshot\n",
        "FEATS3 = FEATS2 + [\"lag_\" + n for n in LAGN] + [\"chg_\" + n for n in LAGN]\n",
        "Xp3 = Xt3.reshape(n_snap * NP, -1)\n",
        "print(\"Features v3:\", Xp3.shape[1])\n",
        "\n",
        "K_SIM = 5\n",
        "SIMC = [FEATS2.index(n) for n in [\"TotalSales\", \"DeliveryEfficiency\", \"Shortfall7d\", \"BacklogWeeks\"]]\n",
        "def knn_edges(Z, k):\n",
        "    D2 = ((Z[:, None, :] - Z[None, :, :]) ** 2).sum(-1); np.fill_diagonal(D2, np.inf)\n",
        "    nn_ = np.argsort(D2, axis=1)[:, :k]\n",
        "    s_, d_ = np.repeat(np.arange(len(Z)), k), nn_.reshape(-1)\n",
        "    return np.unique(np.concatenate([np.stack([s_, d_]), np.stack([d_, s_])], axis=1), axis=1)\n",
        "eis = []\n",
        "for s in range(n_snap):\n",
        "    Z = Xt2[s][:, SIMC]; Z = (Z - Z.mean(0)) / (Z.std(0) + 1e-6)\n",
        "    eis.append(torch.tensor(knn_edges(Z, K_SIM) + s * NP, dtype=torch.long))\n",
        "EI_KNN = torch.cat(eis, dim=1)\n",
        "print(\"Similarity graph edges per snapshot (directed): %.0f vs %d in the relation graph\" % (EI_KNN.size(1) / n_snap, edge_index.size(1)))\n",
        "\n"
