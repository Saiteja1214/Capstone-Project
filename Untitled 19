      "source": [
        "\n",
        "import torch.nn as nn, torch.nn.functional as F\n",
        "from torch_geometric.nn import GCNConv\n",
        "RELS = [\"Plant\", \"Storage\", \"ProductGroup\", \"ProductSubGroup\"]\n",
        "\n",
        "class GCNrel(nn.Module):\n",
        "    \"\"\"A skip from the product's own features plus one GCN convolution per relation type.\"\"\"\n",
        "    def __init__(self, d, hid=32, p_drop=0.3, p_edge=0.3):\n",
        "        super().__init__()\n",
        "        self.skip = nn.Linear(d, hid)\n",
        "        self.convs = nn.ModuleList([GCNConv(d, hid, improved=True) for _ in RELS])\n",
        "        self.o = nn.Linear(hid, 2); self.p_drop, self.p_edge = p_drop, p_edge\n",
        "    def forward(self, x, eis):\n",
        "        h = F.relu(self.skip(x))\n",
        "        for c, ei in zip(self.convs, eis):\n",
        "            if self.training and self.p_edge > 0:\n",
        "                ei = ei[:, torch.rand(ei.size(1)) > self.p_edge]\n",
        "            h = h + F.relu(c(x, ei)) / len(self.convs)\n",
        "        return self.o(F.dropout(h, self.p_drop, self.training))\n",
        "\n",
        "EIS_REL = [union_edges(rel_edge_index[r]) for r in RELS]\n",
        "mk_rel = lambda d: GCNrel(d)\n"
      ]
