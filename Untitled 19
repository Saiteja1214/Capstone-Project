      "source": [
        "\n",
        "\n",
        "import torch, torch.nn as nn, torch.nn.functional as F\n",
        "from torch_geometric.nn import GCNConv\n",
        "from sklearn.metrics import roc_auc_score\n",
        "\n",
        "class GCNv2(nn.Module):\n",
        "    def __init__(self, d, hid=32, layers=1, p_drop=0.3, p_edge=0.3):\n",
        "        super().__init__()\n",
        "        self.skip = nn.Linear(d, hid)\n",
        "        self.convs = nn.ModuleList([GCNConv(d if i == 0 else hid, hid, improved=True) for i in range(layers)])\n",
        "        self.o = nn.Linear(hid, 2); self.p_drop, self.p_edge = p_drop, p_edge\n",
        "    def forward(self, x, ei=None):\n",
        "        if self.training and ei is not None and self.p_edge > 0:                 # DropEdge\n",
        "            ei = ei[:, torch.rand(ei.size(1)) > self.p_edge]\n",
        "        h = F.relu(self.skip(x)); h0 = h\n",
        "        for i, c in enumerate(self.convs):\n",
        "            h = h + F.relu(c(x if i == 0 else h, ei))\n",
        "        return self.o(F.dropout(h, self.p_drop, self.training))\n",
        "\n",
        "def _train(make, X, rows, yb, seed, graph, n_ep, score_rows=None):\n",
        "    torch.manual_seed(seed)\n",
        "    sc = StandardScaler().fit(X[rows])                                          # scaler sees training rows only\n",
        "    Xs = torch.tensor(sc.transform(X), dtype=torch.float)\n",
        "    y = torch.tensor(yb, dtype=torch.long); rt = torch.tensor(rows, dtype=torch.long)\n",
        "    p1 = float(yb[rows].mean()); w = torch.tensor([1 / (1 - p1), 1 / p1], dtype=torch.float); w = w / w.sum() * 2\n",
        "    m = make(Xs.shape[1]); opt = torch.optim.Adam(m.parameters(), lr=0.01, weight_decay=5e-4)\n",
        "    hist = []\n",
        "    for _ in range(n_ep):\n",
        "        m.train(); opt.zero_grad()\n",
        "        F.cross_entropy(m(Xs, graph)[rt], y[rt], weight=w).backward(); opt.step()\n",
        "        if score_rows is not None:\n",
        "            m.eval()\n",
        "            with torch.no_grad():\n",
        "                hist.append(torch.softmax(m(Xs, graph), 1)[:, 1].numpy()[score_rows])\n",
        "    m.eval()\n",
        "    with torch.no_grad():\n",
        "        full = torch.softmax(m(Xs, graph), 1)[:, 1].numpy()\n",
        "    return full, hist\n",
        "\n",
        "def _nn2(make, graph_fn, X, seeds=(0, 1, 2), max_ep=300):\n",
        "    def fn(tr, te, yb, fold):\n",
        "        last = snap_id[tr].max()\n",
        "        inner = tr[snap_id[tr] <= last - 1 - GAP]                                # inner training period\n",
        "        val = tr[snap_id[tr] >= last - 1]                                        # validation = last 2 training snapshots (never the test fold)\n",
        "        s_te = np.zeros(len(te)); thr_all = []\n",
        "        for sd in seeds:\n",
        "            seed = 100 * fold + sd; g = graph_fn(seed)\n",
        "            _, hist = _train(make, X, inner, yb, seed, g, max_ep, score_rows=val)\n",
        "            yv = yb[val]\n",
        "            if len(np.unique(yv)) == 2:\n",
        "                auc = np.array([roc_auc_score(yv, h) for h in hist])\n",
        "                auc = np.convolve(auc, np.ones(5) / 5, mode=\"same\")             # smooth, then pick the best epoch\n",
        "                E = int(np.argmax(auc)) + 1\n",
        "                cand = np.quantile(hist[E - 1], np.linspace(0.3, 0.8, 26))\n",
        "                bal = [balanced_accuracy_score(yv, (hist[E - 1] > c).astype(int)) for c in cand]\n",
        "                thr = float(cand[int(np.argmax(bal))])\n",
        "            else:\n",
        "                E, thr = max_ep // 2, 0.5\n",
        "            full, _ = _train(make, X, tr, yb, seed, g, E)                         # retrain on the whole training period for E epochs\n",
        "            s_te += full[te] / len(seeds); thr_all.append(thr)\n",
        "        t = float(np.mean(thr_all))\n",
        "        return s_te, (s_te > t).astype(int)\n",
        "    return fn\n",
        "\n",
        "EI_PS = torch.cat([rel_edge_index[\"Plant\"], rel_edge_index[\"ProductSubGroup\"]], dim=1)\n",
        "perm_graph = lambda sd: union_edges(torch.tensor(np.random.RandomState(sd).permutation(NP))[edge_index])\n",
        "mk_gcn = lambda d: GCNv2(d, layers=1)\n",
        "mk_nog = lambda d: GCNv2(d, layers=0)\n",
        "\n"
      ]
