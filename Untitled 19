        "    for i, t in enumerate(starts):\n",
        "        if t + H <= T:\n",
        "            fS[i] = piv[\"Sales\"][t:t + H].sum(0); fD[i] = piv[\"Delivery\"][t:t + H].sum(0); BLn[i] = cumS[t + H - 1]\n",
        "    ok = (~np.isnan(fS)) & (np.nan_to_num(fS) >= MIN_FUTURE_SALES_H * H / 14)\n",
        "    wk_ = np.stack([piv[\"Sales\"][t - LOOKBACK:t].sum(0) for t in starts]) / (LOOKBACK / 7)\n",
        "    if mode.startswith(\"shortfall\"):\n",
        "        tgt, pers = (fS - fD) / (fS + eps), Xt[..., COL_LB]\n",
        "    else:\n",
        "        tgt, pers = np.clip(BLn / (wk_ + eps), -10, 10), BLW\n",
        "    return np.nan_to_num(tgt).reshape(-1), ok.reshape(-1), pers.reshape(-1), int(np.ceil(H / STRIDE))\n",
        "\n",
        "def make_folds(ok, gap, n_folds=3):\n",
        "    test_len = max(3, n_snap // (n_folds + 1)); out = []\n",
        "    for k in range(n_folds):\n",
        "        te_start = n_snap - (n_folds - k) * test_len\n",
        "        tr_s, te_s = np.arange(0, te_start - gap), np.arange(te_start, te_start + test_len)\n",
        "        out.append((np.where(np.isin(snap_id, tr_s) & ok)[0], np.where(np.isin(snap_id, te_s) & ok)[0]))\n",
        "    return out\n",
        "\n",
        "def _nn2_safe(make, graph_fn, X, seeds=(0, 1, 2), max_ep=300):\n",
        "    def fn(tr, te, yb, fold):\n",
        "        last = snap_id[tr].max() if len(tr) > 0 else 0\n",
        "        inner = tr[snap_id[tr] <= last - 1 - GAP]\n",
        "        val = tr[snap_id[tr] >= last - 1]\n",
        "        if len(inner) == 0:\n",
        "            inner = tr\n",
        "            val = np.array([])\n",
        "        s_te = np.zeros(len(te)); thr_all = []\n",
        "        for sd in seeds:\n",
        "            seed = 100 * fold + sd; g = graph_fn(seed)\n",
        "            if len(val) > 0:\n",
        "                _, hist = _train(make, X, inner, yb, seed, g, max_ep, score_rows=val)\n",
        "                yv = yb[val]\n",
        "                if len(np.unique(yv)) == 2:\n",
        "                    auc = np.array([roc_auc_score(yv, h) for h in hist])\n",
        "                    auc = np.convolve(auc, np.ones(5) / 5, mode=\"same\")\n",
        "                    E = int(np.argmax(auc)) + 1\n",
        "                    cand = np.quantile(hist[E - 1], np.linspace(0.3, 0.8, 26))\n",
        "                    bal = [balanced_accuracy_score(yv, (hist[E - 1] > c).astype(int)) for c in cand]\n",
        "                    thr = float(cand[int(np.argmax(bal))])\n",
        "                else:\n",
        "                    E, thr = max_ep // 2, 0.5\n",
        "            else:\n",
        "                E, thr = max_ep // 2, 0.5\n",
        "            full, _ = _train(make, X, tr, yb, seed, g, E)\n",
        "            s_te += full[te] / len(seeds); thr_all.append(thr)\n",
        "        t = float(np.mean(thr_all))\n",
        "        return s_te, (s_te > t).astype(int)\n",
        "    return fn\n",
        "\n",
        "table = []\n",
        "for mode in [\"shortfall14\", \"shortfall28\", \"backlog14\", \"backlog28\"]:\n",
        "    tgt, ok, pers, gap = build_target(mode); GAP = gap\n",
        "    res = {}\n",
        "    for k, (tr, te) in enumerate(make_folds(ok, gap)):\n",
        "        if len(tr) == 0:\n",
        "            continue\n",
        "        yb = (tgt > np.quantile(tgt[tr], 2 / 3)).astype(int)\n",
        "        sp, tp = pers[te], np.quantile(pers[tr], 2 / 3)\n",
        "        preds = {\"Majority class\": (np.zeros(len(te)), np.zeros(len(te), dtype=int)),\n",
        "                 \"Persistence\": (sp, (sp > tp).astype(int)),\n",
        "                 \"Random Forest\": _rf(Xuse)(tr, te, yb, k),\n",
        "                 \"No-graph network\": _nn2_safe(mk_nog, lambda sd: None, Xuse)(tr, te, yb, k),\n",
        "                 \"GCN\": _nn2_safe(mk_gcn, lambda sd: EI_UNION, Xuse)(tr, te, yb, k)}\n",
        "        for name, (s, p) in preds.items():\n",
        "            res.setdefault(name, []).append(fold_metrics(yb[te], s, p, tgt[te]))\n",
        "    for name, ms in res.items():\n",
        "        table.append({\"Target\": mode, \"Model\": name, \"Acc\": np.mean([m[\"Acc\"] for m in ms]),\n",
        "                      \"BalAcc\": np.mean([m[\"BalAcc\"] for m in ms]), \"AUC\": np.mean([m[\"AUC\"] for m in ms]),\n",
        "                      \"labelled rows\": int(ok.sum())})\n",
        "    print(\"done:\", mode)\n",
        "GAP = GAP_14\n",
        "study = pd.DataFrame(table)\n",
        "display(study.pivot(index=\"Model\", columns=\"Target\", values=\"Acc\").round(3).rename_axis(\"ACCURACY\"))\n",
        "display(study.pivot(index=\"Model\", columns=\"Target\", values=\"BalAcc\").round(3).rename_axis(\"BALANCED ACCURACY\"))\n",
        "display(study.pivot(index=\"Model\", columns=\"Target\", values=\"AUC\").round(3).rename_axis(\"AUC\"))\n",
        "study.round(4).to_csv(\"Target_Study.csv\", index=False)"
      ]
    },
