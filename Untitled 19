        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import precision_score, recall_score\n",
        "from xgboost import XGBClassifier\n",
        "\n",
        "Xfin, FEATS_FIN = Xp3, FEATS3\n",
        "col_deg = FEATS_FIN.index(\"GraphDegree\")\n",
        "Xnd = np.delete(Xfin, col_deg, axis=1)                       # the same features without the degree column\n",
        "\n",
        "def metrics_full(y, s, pred, sh):\n",
        "    m = fold_metrics(y, s, pred, sh)\n",
        "    m[\"Precision\"] = precision_score(y, pred, zero_division=0)   # precision and recall of the High class\n",
        "    m[\"Recall\"] = recall_score(y, pred, zero_division=0)\n",
        "    return m\n",
        "\n",
        "def _lr(X):\n",
        "    def fn(tr, te, yb, seed):\n",
        "        sc = StandardScaler().fit(X[tr])\n",
        "        m = LogisticRegression(C=0.5, class_weight=\"balanced\", max_iter=2000).fit(sc.transform(X[tr]), yb[tr])\n",
        "        s = m.predict_proba(sc.transform(X[te]))[:, 1]\n",
        "        return s, (s > 0.5).astype(int)\n",
        "    return fn\n",
        "\n",
        "def _xgb(X):\n",
        "    def fn(tr, te, yb, seed):\n",
        "        pos = float(yb[tr].mean())\n",
        "        m = XGBClassifier(n_estimators=300, max_depth=3, learning_rate=0.05, subsample=0.8, colsample_bytree=0.8,\n",
        "                          scale_pos_weight=(1 - pos) / pos, eval_metric=\"logloss\", random_state=seed, n_jobs=-1).fit(X[tr], yb[tr])\n",
        "        s = m.predict_proba(X[te])[:, 1]\n",
        "        return s, (s > 0.5).astype(int)\n",
        "    return fn\n",
        "\n",
        "def _nn2s(make, graph_fn, X, seeds=(0, 1, 2), max_ep=300):    # same as Section 37: falls back when there is no validation period\n",
        "    def fn(tr, te, yb, fold):\n",
        "        last = snap_id[tr].max()\n",
        "        inner = tr[snap_id[tr] <= last - 1 - GAP]; val = tr[snap_id[tr] >= last - 1]\n",
        "        if len(inner) == 0:\n",
        "            inner, val = tr, np.array([], dtype=int)\n",
        "        s_te = np.zeros(len(te)); thr_all = []\n",
        "        for sd in seeds:\n",
        "            seed = 100 * fold + sd; g = graph_fn(seed)\n",
        "            E, thr = max_ep // 2, 0.5\n",
        "            if len(val) > 0 and len(np.unique(yb[val])) == 2:\n",
        "                _, hist = _train(make, X, inner, yb, seed, g, max_ep, score_rows=val)\n",
        "                auc = np.convolve(np.array([roc_auc_score(yb[val], h) for h in hist]), np.ones(5) / 5, mode=\"same\")\n",
        "                E = int(np.argmax(auc)) + 1\n",
        "                cand = np.quantile(hist[E - 1], np.linspace(0.3, 0.8, 26))\n",
        "                thr = float(cand[int(np.argmax([balanced_accuracy_score(yb[val], (hist[E - 1] > c).astype(int)) for c in cand]))])\n",
        "            full, _ = _train(make, X, tr, yb, seed, g, E)\n",
        "            s_te += full[te] / len(seeds); thr_all.append(thr)\n",
        "        t = float(np.mean(thr_all))\n",
        "        return s_te, (s_te > t).astype(int)\n",
        "    return fn\n",
        "\n",
        "def _bt(mode):                                                # target for every row, eligibility, persistence score, gap\n",
        "    H = 28 if mode.endswith(\"28\") else 14\n",
        "    fS = np.full((n_snap, NP), np.nan); fD = np.full((n_snap, NP), np.nan); BLn = np.full((n_snap, NP), np.nan)\n",
        "    cumS = np.cumsum(piv[\"Sales\"] - piv[\"Delivery\"], axis=0)\n",
        "    for i, t in enumerate(starts):\n",
        "        if t + H <= T:\n",
        "            fS[i] = piv[\"Sales\"][t:t + H].sum(0); fD[i] = piv[\"Delivery\"][t:t + H].sum(0); BLn[i] = cumS[t + H - 1]\n",
        "    ok = (~np.isnan(fS)) & (np.nan_to_num(fS) >= MIN_FUTURE_SALES_H * H / 14)\n",
        "    wk_ = np.stack([piv[\"Sales\"][t - LOOKBACK:t].sum(0) for t in starts]) / (LOOKBACK / 7)\n",
        "    if mode.startswith(\"shortfall\"):\n",
        "        tgt, pers = (fS - fD) / (fS + eps), Xt[..., COL_LB]\n",
        "    else:\n",
        "        tgt, pers = np.clip(BLn / (wk_ + eps), -10, 10), BLW\n",
        "    return np.nan_to_num(tgt).reshape(-1), ok.reshape(-1), pers.reshape(-1), int(np.ceil(H / STRIDE))\n",
        "\n",
        "def _mf(ok, gap, n_folds=3):\n",
        "    test_len = max(3, n_snap // (n_folds + 1)); out = []\n",
        "    for k in range(n_folds):\n",
        "        te_start = n_snap - (n_folds - k) * test_len\n",
        "        tr_s, te_s = np.arange(0, te_start - gap), np.arange(te_start, te_start + test_len)\n",
        "        out.append((np.where(np.isin(snap_id, tr_s) & ok)[0], np.where(np.isin(snap_id, te_s) & ok)[0]))\n",
        "    return out\n",
        "\n",
        "# %%\n",
        "PAIRS = [(\"GCN, similarity graph\", \"No-graph network\"), (\"GCN, relation graph\", \"No-graph network\"),\n",
        "         (\"GCN, relation graph\", \"GCN, permuted graph\"), (\"GCN, similarity graph\", \"GCN, permuted graph\"),\n",
        "         (\"GCN, similarity graph\", \"Persistence\"), (\"Random Forest\", \"Persistence\"),\n",
        "         (\"GCN, similarity graph (no degree)\", \"No-graph network (no degree)\")]\n",
        "\n",
        "def run_target(mode, n_boot=1000):\n",
        "    global GAP\n",
        "    gap_old = GAP\n",
        "    tgt, ok, pers, gap = _bt(mode); GAP = gap\n",
        "    models = {\"Majority class\": None, \"Persistence\": None,\n",
        "              \"Logistic regression\": _lr(Xfin), \"Random Forest\": _rf(Xfin), \"XGBoost\": _xgb(Xfin),\n",
        "              \"No-graph network\": _nn2s(mk_nog, lambda sd: None, Xfin),\n",
        "              \"GCN, relation graph\": _nn2s(mk_gcn, lambda sd: EI_UNION, Xfin),\n",
        "              \"GCN, similarity graph\": _nn2s(mk_gcn, lambda sd: EI_KNN, Xfin),\n",
        "              \"GCN, Plant + SubGroup\": _nn2s(mk_gcn, lambda sd: EI_PS_UNION, Xfin),\n",
        "              \"GCN, permuted graph\": _nn2s(mk_gcn, perm_graph, Xfin),\n",
        "              \"Random Forest (no degree)\": _rf(Xnd), \"No-graph network (no degree)\": _nn2s(mk_nog, lambda sd: None, Xnd),\n",
        "              \"GCN, similarity graph (no degree)\": _nn2s(mk_gcn, lambda sd: EI_KNN, Xnd)}\n",
        "    n = len(tgt); pool_p = {m: np.full(n, -1) for m in models}; pool_y = np.full(n, -1); rows = []\n",
        "    for k, (tr, te) in enumerate(_mf(ok, gap)):\n",
        "        if len(tr) == 0:\n",
        "            continue\n",
        "        yb = (tgt > np.quantile(tgt[tr], 2 / 3)).astype(int)          # threshold from the training period only\n",
        "        pool_y[te] = yb[te]\n",
        "        sp, tp = pers[te], np.quantile(pers[tr], 2 / 3)\n",
        "        for m, fn in models.items():\n",
        "            if m == \"Majority class\": s, p = np.zeros(len(te)), np.zeros(len(te), dtype=int)\n",
        "            elif m == \"Persistence\": s, p = sp, (sp > tp).astype(int)\n",
        "            else: s, p = fn(tr, te, yb, k)\n",
        "            pool_p[m][te] = p\n",
        "            r = metrics_full(yb[te], s, p, tgt[te]); r.update(Target=mode, Model=m, Fold=k); rows.append(r)\n",
        "        print(mode, \"fold\", k, \"done\")\n",
        "    GAP = gap_old\n",
        "    rows_all = np.where(pool_y >= 0)[0]; snaps = np.unique(snap_id[rows_all])\n",
        "    by = {s_: rows_all[snap_id[rows_all] == s_] for s_ in snaps}\n",
        "    rng = np.random.RandomState(0)\n",
        "    samples_ = [np.concatenate([by[s_] for s_ in rng.choice(snaps, len(snaps))]) for _ in range(n_boot)]\n",
        "    boot = {m: np.array([balanced_accuracy_score(pool_y[ix], pool_p[m][ix]) for ix in samples_]) for m in models}\n",
        "    ci = {m: (balanced_accuracy_score(pool_y[rows_all], pool_p[m][rows_all]), np.percentile(boot[m], 2.5), np.percentile(boot[m], 97.5)) for m in models}\n",
        "    diffs = {(a, b): (boot[a] - boot[b]) for a, b in PAIRS}\n",
        "    return pd.DataFrame(rows), ci, diffs, float(1 - pool_y[rows_all].mean()), len(rows_all)\n",
        "\n",
        "FINAL = {}\n",
        "for mode in [\"shortfall14\", \"backlog14\"]:\n",
        "    FINAL[mode] = run_target(mode)\n",
        "\n",
        "all_rows = []\n",
        "for mode, (df, ci, diffs, maj, nrows) in FINAL.items():\n",
        "    g = df.groupby(\"Model\", sort=False)[[\"BalAcc\", \"MacroF1\", \"AUC\", \"Precision\", \"Recall\", \"Acc\"]].mean()\n",
        "    g[\"Pooled BalAcc\"] = [ci[m][0] for m in g.index]; g[\"CI low\"] = [ci[m][1] for m in g.index]; g[\"CI high\"] = [ci[m][2] for m in g.index]\n",
        "    print(f\"\\n==== {mode}: {nrows} held-out rows | majority-class accuracy {maj:.3f} ====\")\n",
        "    display(g.round(3))\n",
        "    print(\"Paired differences in balanced accuracy (95% CI); a CI that excludes 0 is a real difference\")\n",
        "    for (a, b), d in diffs.items():\n",
        "        print(f\"  {a} - {b}: {d.mean():+.3f}  [{np.percentile(d, 2.5):+.3f}, {np.percentile(d, 97.5):+.3f}]\")\n",
        "    g.insert(0, \"Target\", mode); all_rows.append(g.reset_index())\n",
        "pd.concat(all_rows).round(4).to_csv(\"Final_Results.csv\", index=False)"
      ]
