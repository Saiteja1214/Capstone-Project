      "source": [
        "# import pandas as pd\n",
        "# import numpy as np\n",
        "\n",
        "# # Ensure Date is parsed as datetime\n",
        "# master_df['Date'] = pd.to_datetime(master_df['Date'])\n",
        "# unique_dates = sorted(master_df['Date'].unique())\n",
        "\n",
        "# split_date = unique_dates[150]\n",
        "# print(f\"Splitting data at: {split_date}\")\n",
        "\n",
        "# # Split master operational dataset\n",
        "# feature_window_df = master_df[master_df['Date'] < split_date]\n",
        "# target_window_df = master_df[master_df['Date'] >= split_date]\n",
        "\n",
        "# print(f\"Feature window records: {len(feature_window_df)}\")\n",
        "# print(f\"Target window records: {len(target_window_df)}\")\n",
        "import numpy as np, pandas as pd\n",
        "\n",
        "FEATURE_DAYS = 150          # feature window = first 150 days; target window = the rest\n",
        "MIN_FUTURE_SALES = 100.0    # a shortfall rate is undefined without demand; products below this are not labelled\n",
        "eps = 1e-6\n",
        "\n",
        "md = master_df.copy()\n",
        "md[\"Date\"] = pd.to_datetime(md[\"Date\"])\n",
        "# POP001L12P and POP001L12P.1 are one product recorded twice: sum them so there is ONE row per product\n",
        "md[\"Product\"] = md[\"Product\"].astype(str).str.replace(r\"\\.1$\", \"\", regex=True)\n",
        "md = md.groupby([\"Date\", \"Product\"], as_index=False)[[\"Sales\", \"Production\", \"FactoryIssue\", \"Delivery\"]].sum()\n",
        "\n",
        "dates = sorted(md[\"Date\"].unique())\n",
        "split_date = dates[FEATURE_DAYS]\n",
        "feat_df = md[md[\"Date\"] < split_date]\n",
        "targ_df = md[md[\"Date\"] >= split_date]\n",
        "print(\"Split date:\", pd.Timestamp(split_date).date(),\n",
        "      \"| feature days:\", feat_df[\"Date\"].nunique(), \"| target days:\", targ_df[\"Date\"].nunique(),\n",
        "      \"| products:\", md[\"Product\"].nunique())"
      ]
    },
