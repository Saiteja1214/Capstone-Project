        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "import numpy as np\n",
        "import sklearn.metrics\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "print(\"========== Model Results (MLP Baseline & Evaluation) ==========\")\n",
        "\n",
        "# 1. Recreate train/test masks on the static data to prevent AttributeError\n",
        "y_numpy = y.cpu().numpy() if hasattr(y, 'cpu') else np.asarray(y)\n",
        "train_indices, test_indices = train_test_split(\n",
        "    np.arange(len(y_numpy)),\n",
        "    test_size=0.3,\n",
        "    random_state=42,\n",
        "    stratify=y_numpy\n",
        ")\n",
        "\n",
        "train_mask = torch.zeros(len(y_numpy), dtype=torch.bool)\n",
        "train_mask[train_indices] = True\n",
        "\n",
        "test_mask = torch.zeros(len(y_numpy), dtype=torch.bool)\n",
        "test_mask[test_indices] = True\n",
        "\n",
        "# 2. Re-scale features on training nodes only to prevent leakage\n",
        "sc = StandardScaler().fit(product_features[feature_columns].values[train_indices])\n",
        "X_scaled = torch.tensor(sc.transform(product_features[feature_columns].values), dtype=torch.float)\n",
        "y_tensor = torch.tensor(y_numpy, dtype=torch.long)\n",
        "\n",
        "print(f\"Train nodes count: {train_mask.sum().item()}\")\n",
        "print(f\"Test nodes count: {test_mask.sum().item()}\")\n",
        "\n",
        "# 3. Define and train the MLP\n",
        "class RiskMLP(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.fc1 = nn.Linear(13, 32)\n",
        "        self.fc2 = nn.Linear(32, 16)\n",
        "        self.classifier = nn.Linear(16, 3)\n",
        "    def forward(self, x):\n",
        "        x = F.relu(self.fc1(x))\n",
        "        x = F.relu(self.fc2(x))\n",
        "        return self.classifier(x)\n",
        "\n",
        "torch.manual_seed(42)\n",
        "mlp_model = RiskMLP()\n",
        "mlp_criterion = nn.CrossEntropyLoss()\n",
        "mlp_optimizer = torch.optim.Adam(mlp_model.parameters(), lr=0.01)\n",
        "\n",
        "for epoch in range(300):\n",
        "    mlp_model.train()\n",
        "    mlp_optimizer.zero_grad()\n",
        "    output = mlp_model(X_scaled)\n",
        "    loss = mlp_criterion(output[train_mask], y_tensor[train_mask])\n",
        "    loss.backward()\n",
        "    mlp_optimizer.step()\n",
        "\n",
        "mlp_model.eval()\n",
        "with torch.no_grad():\n",
        "    mlp_out = mlp_model(X_scaled)\n",
        "    mlp_pred = mlp_out.argmax(dim=1)\n",
        "\n",
        "y_true_mlp = y_tensor[test_mask].cpu().numpy()\n",
        "y_pred_mlp = mlp_pred[test_mask].cpu().numpy()\n",
        "\n",
        "print(\"\\nMLP Classification Report:\")\n",
        "print(sklearn.metrics.classification_report(y_true_mlp, y_pred_mlp, target_names=[\"Low\",\"Medium\",\"High\"]))\n",
        "print(\"MLP Confusion Matrix:\")\n",
        "print(sklearn.metrics.confusion_matrix(y_true_mlp, y_pred_mlp))"
