        "\n",
        "import torch, torch.nn as nn, torch.nn.functional as F\n",
        "from torch_geometric.nn import GCNConv\n",
        "\n",
        "assert int(edge_index.max()) < NP\n",
        "def union_edges(ei):\n",
        "    return torch.cat([ei + s * NP for s in range(n_snap)], dim=1)\n",
        "EI_UNION = union_edges(edge_index)\n",
        "\n",
        "class PMLP(nn.Module):\n",
        "    def __init__(self, d):\n",
        "        super().__init__(); self.a, self.b, self.o = nn.Linear(d, 32), nn.Linear(32, 16), nn.Linear(16, 2)\n",
        "    def forward(self, x, ei=None):\n",
        "        h = F.dropout(F.relu(self.a(x)), 0.2, self.training)\n",
        "        return self.o(F.relu(self.b(h)))\n",
        "\n",
        "class PGCN(nn.Module):\n",
        "    def __init__(self, d):\n",
        "        super().__init__(); self.c1, self.c2, self.o = GCNConv(d, 32), GCNConv(32, 16), nn.Linear(16, 2)\n",
        "    def forward(self, x, ei):\n",
        "        h = F.dropout(F.relu(self.c1(x, ei)), 0.2, self.training)\n",
        "        return self.o(F.relu(self.c2(h, ei)))\n",
        "\n",
        "def train_nn(make, tr, yb, seed, graph, epochs=200):\n",
        "    torch.manual_seed(seed)\n",
        "    sc = StandardScaler().fit(Xp[tr])                                       # scaler sees training rows only\n",
        "    Xs = torch.tensor(sc.transform(Xp), dtype=torch.float)\n",
        "    y = torch.tensor(yb, dtype=torch.long); trt = torch.tensor(tr, dtype=torch.long)\n",
        "    p1 = float(yb[tr].mean()); w = torch.tensor([1 / (1 - p1), 1 / p1], dtype=torch.float); w = w / w.sum() * 2\n",
        "    m = make(Xs.shape[1]); opt = torch.optim.Adam(m.parameters(), lr=0.01, weight_decay=5e-4)\n",
        "    for _ in range(epochs):\n",
        "        m.train(); opt.zero_grad()\n",
        "        F.cross_entropy(m(Xs, graph)[trt], y[trt], weight=w).backward(); opt.step()\n",
        "    m.eval()\n",
        "    return m, sc, Xs\n",
        "\n",
        "def _nn(make, graph_fn, seeds=(0, 1, 2)):\n",
        "    def fn(tr, te, yb, seed):\n",
        "        s = np.zeros(len(te))\n",
        "        for sd in seeds:\n",
        "            m, sc, Xs = train_nn(make, tr, yb, 100 * seed + sd, graph_fn(100 * seed + sd))\n",
        "            with torch.no_grad():\n",
        "                s += torch.softmax(m(Xs, graph_fn(100 * seed + sd)), 1)[:, 1].numpy()[te] / len(seeds)\n",
        "        return s, (s > 0.5).astype(int)\n",
        "    return fn\n",
        "p_mlp = _nn(PMLP, lambda sd: None)\n",
        "p_gcn = _nn(PGCN, lambda sd: EI_UNION)\n",
        "p_gcn_perm = _nn(PGCN, lambda sd: union_edges(torch.tensor(np.random.RandomState(sd).permutation(NP))[edge_index]))\n",
        "def _rel(rel): return _nn(PGCN, lambda sd: union_edges(rel_edge_index[rel]))"
      ]
