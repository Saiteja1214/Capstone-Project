        "from scipy.stats import spearmanr\n",
        "\n",
        "N_FOLDS = 3\n",
        "test_len = max(3, n_snap // (N_FOLDS + 1))\n",
        "folds = []\n",
        "for k in range(N_FOLDS):\n",
        "    te_start = n_snap - (N_FOLDS - k) * test_len\n",
        "    te_s = np.arange(te_start, te_start + test_len)\n",
        "    tr_s = np.arange(0, te_start - GAP)\n",
        "    folds.append((np.where(np.isin(snap_id, tr_s) & elig)[0], np.where(np.isin(snap_id, te_s) & elig)[0]))\n",
        "    print(f\"fold {k}: train snapshots 0-{tr_s[-1]} ({len(folds[-1][0])} rows) | test snapshots {te_s[0]}-{te_s[-1]} ({len(folds[-1][1])} rows)\")\n",
        "\n",
        "COL_LB = FEATS_P.index(\"ShortfallLookback\")\n",
        "\n",
        "def p_majority(tr, te, yb, seed):\n",
        "    return np.zeros(len(te)), np.zeros(len(te), dtype=int)\n",
        "\n",
        "def p_persistence(tr, te, yb, seed):\n",
        "    thr = np.quantile(Xp[tr, COL_LB], 2 / 3)               # \"next window looks like the last window\"\n",
        "    s = Xp[te, COL_LB]\n",
        "    return s, (s > thr).astype(int)\n",
        "\n",
        "def _rf(X):\n",
        "    def fn(tr, te, yb, seed):\n",
        "        m = RandomForestClassifier(n_estimators=300, min_samples_leaf=3, class_weight=\"balanced_subsample\",\n",
        "                                   random_state=seed, n_jobs=-1).fit(X[tr], yb[tr])\n",
        "        s = m.predict_proba(X[te])[:, 1]\n",
        "        return s, (s > 0.5).astype(int)\n",
        "    return fn\n",
        "p_rf = _rf(Xp)\n",
        "p_rf_nb = _rf(np.hstack([Xp, NBp]))\n",
        "\n",
        "def fold_metrics(y, s, pred, sh):\n",
