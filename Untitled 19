      "source": [
        "def explain_product(row):\n",
        "    reasons = []\n",
        "    if row[\"FactoryIssueRatio\"] > 1:\n",
        "        reasons.append(\"High Factory Issues\")\n",
        "    if row[\"ProductionEfficiency\"] < 0.95:\n",
        "        reasons.append(\"Low Production Efficiency\")\n",
        "    if row[\"DeliveryEfficiency\"] < 0.95:\n",
        "        reasons.append(\"Low Delivery Efficiency\")\n",
        "    if row[\"SalesCV\"] > 1:\n",
        "        reasons.append(\"Unstable Sales Demand\")\n",
        "    if row[\"ProductionCV\"] > 1:\n",
        "        reasons.append(\"Unstable Production\")\n",
        "    if len(reasons) == 0:\n",
        "        reasons.append(\"Stable Supply Chain Behaviour\")\n",
        "    return \", \".join(reasons)\n",
        "product_features[\"Reason\"] = product_features.apply(\n",
        "    explain_product,\n",
        "    axis=1\n",
        ")"
      ]
    },
