      "source": [
        "feature_map = {\n",
        "    \"ProdEff_Contribution\": \"Low Production Efficiency\",\n",
        "    \"DeliveryEff_Contribution\": \"Low Delivery Efficiency\",\n",
        "    \"Factory_Contribution\": \"High Factory Issues\",\n",
        "    \"SalesCV_Contribution\": \"Unstable Sales Demand\",\n",
        "    \"ProductionCV_Contribution\": \"Unstable Production\",\n",
        "    \"SalesGap_Contribution\": \"High Sales Gap\",\n",
        "    \"ProductionGap_Contribution\": \"High Production Gap\"\n",
        "}\n",
        "\n",
        "def dynamic_reason(row):\n",
        "\n",
        "    contributions = {\n",
        "        feature_map[col]: row[col]\n",
        "        for col in feature_map\n",
        "    }\n",
        "\n",
        "    # Keep only meaningful contributors\n",
        "    significant = {\n",
        "        k: v for k, v in contributions.items()\n",
        "        if v > 0.50\n",
        "    }\n",
        "\n",
        "    if row[\"RiskLabel\"] == 0:\n",
        "\n",
        "        if len(significant) == 0:\n",
        "            return \"Stable Supply Chain Behaviour\"\n",
        "\n",
        "        top = sorted(\n",
        "            significant.items(),\n",
        "            key=lambda x: x[1],\n",
        "            reverse=True\n",
        "        )[:1]\n",
        "\n",
        "        return \"Overall Stable. Minor Concern: \" + top[0][0]\n",
        "\n",
        "    elif row[\"RiskLabel\"] == 1:\n",
        "\n",
        "        top = sorted(\n",
        "            significant.items(),\n",
        "            key=lambda x: x[1],\n",
        "            reverse=True\n",
        "        )[:2]\n",
        "\n",
        "        if len(top) == 0:\n",
        "            return \"Moderate Supply Chain Risk\"\n",
        "\n",
        "        return \"Moderate Risk due to: \" + \", \".join(\n",
        "            [x[0] for x in top]\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        top = sorted(\n",
        "            significant.items(),\n",
        "            key=lambda x: x[1],\n",
        "            reverse=True\n",
        "        )[:3]\n",
        "\n",
        "        if len(top) == 0:\n",
        "            return \"High Risk\"\n",
        "\n",
        "        return \"High Risk due to: \" + \", \".join(\n",
        "            [x[0] for x in top]\n",
        "        )"
      ]
    },
