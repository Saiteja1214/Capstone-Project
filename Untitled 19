        "# SECTION 15A\n",
        "# Calculate Dynamic Feature Contributions"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Sm3unlaB8TwI"
      },
      "outputs": [],
      "source": [
        "explain_df = product_features.copy()\n",
        "explain_df[\"ProdEff_Contribution\"] = 1 - explain_df[\"ProductionEfficiency\"]\n",
        "explain_df[\"DeliveryEff_Contribution\"] = 1 - explain_df[\"DeliveryEfficiency\"]\n",
        "explain_df[\"Factory_Contribution\"] = explain_df[\"FactoryIssueRatio\"]\n",
        "explain_df[\"SalesCV_Contribution\"] = explain_df[\"SalesCV\"]\n",
        "explain_df[\"ProductionCV_Contribution\"] = explain_df[\"ProductionCV\"]\n",
        "explain_df[\"SalesGap_Contribution\"] = explain_df[\"SalesGap\"]\n",
        "explain_df[\"ProductionGap_Contribution\"] = explain_df[\"ProductionGap\"]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "7pVlrRlV8aTD"
      },
      "outputs": [],
      "source": [
        "feature_map = {\n",
        "    \"ProdEff_Contribution\":\"Low Production Efficiency\",\n",
        "    \"DeliveryEff_Contribution\":\"Low Delivery Efficiency\",\n",
        "    \"Factory_Contribution\":\"High Factory Issues\",\n",
        "    \"SalesCV_Contribution\":\"Unstable Sales Demand\",\n",
        "    \"ProductionCV_Contribution\":\"Unstable Production\",\n",
        "    \"SalesGap_Contribution\":\"High Sales Gap\",\n",
        "    \"ProductionGap_Contribution\":\"High Production Gap\"\n",
        "}\n",
        "def dynamic_reason(row):\n",
        "    contributions = {\n",
        "        feature_map[col]: row[col]\n",
        "        for col in feature_map\n",
        "    }\n",
        "    top3 = sorted(\n",
        "        contributions.items(),\n",
        "        key=lambda x:x[1],\n",
        "        reverse=True\n",
        "    )[:3]\n",
        "    return \", \".join(\n",
        "        [reason for reason,value in top3]\n",
        "    )\n",
        "explain_df[\"DynamicReason\"] = explain_df.apply(\n",
        "    dynamic_reason,\n",
        "    axis=1\n",
        ")"
      ]
    },
