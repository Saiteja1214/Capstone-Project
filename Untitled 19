      "source": [
        "\n",
        "cum = np.cumsum(piv[\"Sales\"] - piv[\"Delivery\"], axis=0)                       # cumulative undelivered sales per product\n",
        "bl = np.stack([cum[t - 1] for t in starts])                                   # backlog at the start of each snapshot\n",
        "wk_sales = np.stack([piv[\"Sales\"][t - LOOKBACK:t].sum(0) for t in starts]) / (LOOKBACK / 7)\n",
        "BLW = np.clip(bl / (wk_sales + eps), -10, 10)                                 # backlog measured in weeks of sales\n",
        "\n",
        "def _short(a, b):\n",
        "    S, D = piv[\"Sales\"][a:b].sum(0), piv[\"Delivery\"][a:b].sum(0)\n",
        "    return (S - D) / (S + eps)\n",
        "prev_short = np.stack([_short(t - 2 * LOOKBACK, t - LOOKBACK) if t >= 2 * LOOKBACK else Xraw[i, :, 12]\n",
        "                       for i, t in enumerate(starts)])\n",
        "prev_short = np.clip(prev_short, -5, 1)\n",
        "trend = Xt[..., 12] - prev_short                                              # is the shortfall getting better or worse?\n",
        "\n",
        "def vs_own_past(A):                                                           # value minus the mean of the product's EARLIER snapshots\n",
        "    out = np.zeros_like(A)\n",
        "    for s in range(1, A.shape[0]):\n",
        "        out[s] = A[s] - A[:s].mean(0)\n",
        "    return out\n",
        "DEV_COLS = [0, 3, 6, 7, 11, 12]        # TotalSales, TotalDelivery, ProductionEfficiency, DeliveryEfficiency, Shortfall7d, ShortfallLookback\n",
        "DEV = np.stack([vs_own_past(Xt[..., c]) for c in DEV_COLS], axis=2)\n",
        "\n",
        "Xt2 = np.concatenate([Xt, BLW[..., None], prev_short[..., None], trend[..., None], DEV], axis=2)\n",
        "FEATS2 = FEATS_P + [\"BacklogWeeks\", \"PrevShortfall\", \"ShortfallTrend\"] + [\"d_\" + FEATS_P[c] for c in DEV_COLS]\n",
        "Xp2 = Xt2.reshape(n_snap * NP, -1)\n",
        "print(\"Features v2:\", Xp2.shape[1], \"| new:\", FEATS2[len(FEATS_P):])\n"
