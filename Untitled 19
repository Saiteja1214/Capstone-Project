        "# ============================================================\n",
        "# PySpark Function: Convert Wide Format to Long Format\n",
        "# ============================================================\n",
        "\n",
        "from pyspark.sql import functions as F\n",
        "\n",
        "def wide_to_long_spark(df, value_name):\n",
        "\n",
        "    id_col = \"Date\"\n",
        "\n",
        "    value_cols = [\n",
        "        c for c in df.columns\n",
        "        if c != id_col\n",
        "    ]\n",
        "\n",
        "    # Create an array of structs instead of using stack()\n",
        "    # This safely handles columns such as POP001L12P.1\n",
        "    array_expr = F.array(*[\n",
        "        F.struct(\n",
        "            F.lit(c).alias(\"Product\"),\n",
        "            F.col(f\"`{c}`\").cast(\"double\").alias(value_name)\n",
        "        )\n",
        "        for c in value_cols\n",
        "    ])\n",
        "\n",
        "    return (\n",
        "        df\n",
        "        .select(\n",
        "            F.col(id_col),\n",
        "            F.explode(array_expr).alias(\"temp\")\n",
        "        )\n",
        "        .select(\n",
        "            F.col(id_col),\n",
        "            F.col(\"temp.Product\").alias(\"Product\"),\n",
        "            F.col(f\"temp.{value_name}\").alias(value_name)\n",
        "        )\n",
        "        .filter(F.col(value_name).isNotNull())\n",
        "    )\n",
        "\n",
        "\n",
        "print(\"wide_to_long_spark function created successfully.\")"
      ]
